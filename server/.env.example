# Server Configuration
PORT=5000

# MySQL Database Configuration (Matches lagatour_db.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=lagatour_db

# Third-Party Email Service Configuration (SMTP / Nodemailer)
# Fill in your SMTP credentials for production email delivery (e.g. Gmail / Outlook / Mailtrap / Sendgrid)
# If left empty, verification codes are logged to the server terminal with a test preview.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LagaTour Verification <noreply@lagatour.com>"

# Google Gemini API Key (get free key from https://aistudio.google.com/)
GEMINI_API_KEY=
